# Quy tắc header (Vite copy file này vào dist khi build) — Story 9.1, dùng chung cho Netlify và Cloudflare Pages
# Service Worker, manifest và trang HTML KHÔNG được lưu cache lâu: nếu không, điện thoại đã cài app có thể kẹt ở bản cũ sau khi deploy.
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Story 19.9: Content-Security-Policy cho mọi trang — giảm rủi ro XSS đọc token đăng nhập (bản Cloudflare lưu Refresh Token ở máy).
# Chỉ cho phép script của chính trang; kết nối tới backend Render, Cloudinary, Nominatim; ảnh bản đồ CARTO / OSM / ArcGIS.
# THÊM DỊCH VỤ MỚI (backend khác, nguồn bản đồ khác...) → bổ sung tên miền vào đây, nếu không trình duyệt sẽ chặn.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://res.cloudinary.com https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com https://tile.openstreetmap.org https://*.tile.openstreetmap.org https://server.arcgisonline.com; media-src 'self' blob: https://res.cloudinary.com; connect-src 'self' https://roommaster-api-0keh.onrender.com https://api.cloudinary.com https://res.cloudinary.com https://nominatim.openstreetmap.org; font-src 'self' data:; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# File build có mã hash trong tên → cache lâu dài (Netlify đọc thêm quy tắc này từ netlify.toml, Cloudflare chỉ đọc ở đây)
/assets/*
  Cache-Control: public, max-age=31536000, immutable
