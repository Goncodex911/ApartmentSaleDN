# ==========================================
# CẤU HÌNH HỆ THỐNG QUẢN LÝ CĂN HỘ (EXAMPLE)
# ==========================================

PORT=5000
# production: bật cookie Secure. Render tự đặt PORT, không cần khai báo trên Render
NODE_ENV=development
# Số tầng proxy đứng trước server để lấy đúng IP khách (giới hạn tần suất chat AI):
#   Netlify -> Render = 2 | Nginx -> Node = 1 | chạy trực tiếp local = để trống
TRUST_PROXY=

# 1. MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@sale.jtnrk3b.mongodb.net/apartment_sale?retryWrites=true&w=majority&appName=sale

# 2. JWT Authentication
# BẮT BUỘC — thiếu biến này server sẽ không khởi động. Dùng chuỗi ngẫu nhiên dài, tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# 3. Frontend Client URL
# Tên miền Frontend — dùng cho CORS và để tạo link xem phòng gửi khách (Story 5.3)
# VD khi deploy Netlify: https://ten-site.netlify.app
CLIENT_URL=http://localhost:5173

# 4. Tích hợp AI (Gemini Flash để Parse tin & Auto Chat)
GEMINI_API_KEY=your_gemini_api_key_here
# Tùy chọn: tên model Gemini (để trống = gemini-3.5-flash-lite)
GEMINI_MODEL=
# Tùy chọn: model dự phòng khi model chính quá tải (lỗi 503 "high demand" / 429).
# Không khai báo = gemini-3.5-flash. Khai báo rỗng (GEMINI_FALLBACK_MODEL=) để tắt dự phòng.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Tùy chọn: tỷ giá quy đổi khi tin chỉ ghi giá USD (để trống = 25000). Tin quy đổi luôn được gắn cờ "Cần kiểm tra".
USD_VND_RATE=

# 5. Tích hợp Telegram Ingestion
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Danh sách chat ID của các nhóm được phép nhập tin, cách nhau dấu phẩy (VD: -1001234567890,-1009876543210).
# Story 13.5: Admin quản lý nhóm nguồn trên web (Quản trị → Cấu hình). Biến này chỉ là DỰ PHÒNG khi trên web chưa thêm nhóm nào.
# Để trống = nhận tin từ MỌI cuộc trò chuyện có bot (kể cả người lạ nhắn riêng) — nên điền khi chạy thật.
# Lấy chat ID: thêm bot vào nhóm, gửi 1 tin, mở https://api.telegram.org/bot<TOKEN>/getUpdates và xem "chat":{"id":...}
TELEGRAM_SOURCE_CHAT_IDS=

# 5b. Secret cho các cổng nhận tin không đăng nhập (Webhook WhatsApp, Chrome Extension bản "-public")
# Bên gửi phải kèm header:  x-webhook-secret: <giá trị này>
# Để trống = khóa các cổng này (trả 503). Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGESTION_WEBHOOK_SECRET=

# 6. Cấu hình Upload Ảnh / Video Căn hộ (Epic 2)
# Khuyên dùng Cloudinary (miễn phí) hoặc để trống nếu dùng lưu trữ cục bộ (Local Server)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 7. Cấu hình Bản đồ & Địa không gian (Epic 15 - 0 VND, không bắt buộc)
# Khuyên dùng: tile CARTO Voyager — CẦN key miễn phí (https://carto.com/basemaps/), khóa key theo website,
# miễn phí ≤ 1 triệu tile/tháng cho app kinh doanh. Không khai báo → dùng tile OpenStreetMap chuẩn.
# LƯU Ý: biến VITE_ phải đặt ở frontend/.env.local (chạy local) hoặc Netlify Environment variables (build) —
# Vite KHÔNG đọc file .env ở gốc repo này.
# VITE_MAP_TILE_URL=https://basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png?key=YOUR_CARTO_KEY
# Tùy chọn: User-Agent khi gọi geocoding tên đường tự động (Story 15.6)
# NOMINATIM_USER_AGENT=RoomMaster-Danang/1.0

# Story 16.8b — dung lượng tối đa gói MongoDB Atlas (MB) để tính % trên trang Sức khỏe hệ thống.
# Gói Free M0 = 512. Nâng gói (VD M2 = 2048) thì sửa số này trên Render. Không bắt buộc.
# ATLAS_STORAGE_LIMIT_MB=512

# 8. Cấu hình Đăng Tin Đa Kênh & Chuẩn Hóa Bản Đồ (Epic 17 - 0 VND, không bắt buộc)
# Zalo & WhatsApp: sử dụng Universal Deep-link 1-chạm cá nhân và Web Share API, KHÔNG cần API Key.
# Google Maps: Backend tự giải mã sâu chuỗi HTTP redirect, KHÔNG cần mua Google Maps API.
# Tỷ giá USD cho WhatsApp: dùng chung biến USD_VND_RATE ở mục 4 (mặc định: 25000).

# 9. Cấu hình Telegram MTProto Client (Cover Epic CE-01 - Userbot Scraper Tự Động, 0 VND)
# Đăng ký 1 lần duy nhất tại https://my.telegram.org (xem hướng dẫn chi tiết tại EXTERNAL_CONFIG.md mục 11)
# Dùng để người dùng tự kết nối Telegram cá nhân cào tin từ các nhóm kín/công khai.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=


