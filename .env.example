# ==========================================
# CẤU HÌNH HỆ THỐNG QUẢN LÝ CĂN HỘ (EXAMPLE)
# ==========================================

PORT=5000
NODE_ENV=development

# 1. MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@sale.jtnrk3b.mongodb.net/apartment_sale?retryWrites=true&w=majority&appName=sale

# 2. JWT Authentication
# BẮT BUỘC — thiếu biến này server sẽ không khởi động. Dùng chuỗi ngẫu nhiên dài, tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# 3. Frontend Client URL
CLIENT_URL=http://localhost:5173

# 4. Tích hợp AI (Gemini Flash để Parse tin & Auto Chat)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Tích hợp Telegram Ingestion
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# Danh sách chat ID của các nhóm được phép nhập tin, cách nhau dấu phẩy (VD: -1001234567890,-1009876543210).
# Để trống = nhận tin từ MỌI cuộc trò chuyện có bot (kể cả người lạ nhắn riêng) — nên điền khi chạy thật.
# Lấy chat ID: thêm bot vào nhóm, gửi 1 tin, mở https://api.telegram.org/bot<TOKEN>/getUpdates và xem "chat":{"id":...}
TELEGRAM_SOURCE_CHAT_IDS=

# 5b. Secret cho các cổng nhận tin không đăng nhập (Webhook WhatsApp, Chrome Extension bản "-public")
# Bên gửi phải kèm header:  x-webhook-secret: <giá trị này>
# Để trống = khóa các cổng này (trả 503). Tạo bằng lệnh:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGESTION_WEBHOOK_SECRET=

# 6. Cấu hình Upload Ảnh / Video Căn hộ (Epic 2)
# Khuyên dùng Cloudinary (miễn phí) hoặc để trống nếu dùng lưu trữ cục bộ (Local Server)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

