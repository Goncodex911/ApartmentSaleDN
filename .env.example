# ==========================================
# CẤU HÌNH HỆ THỐNG QUẢN LÝ CĂN HỘ (EXAMPLE)
# ==========================================

PORT=5000
NODE_ENV=development

# 1. MongoDB Atlas Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@sale.jtnrk3b.mongodb.net/apartment_sale?retryWrites=true&w=majority&appName=sale

# 2. JWT Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# 3. Frontend Client URL
CLIENT_URL=http://localhost:5173

# 4. Tích hợp AI (Gemini Flash để Parse tin & Auto Chat)
GEMINI_API_KEY=your_gemini_api_key_here

# 5. Tích hợp Telegram Ingestion
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_SOURCE_CHAT_IDS=

